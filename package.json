{
  "name": "my-project",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.18 <25",
    "npm": ">=10 <12"
  },
  "scripts": {
    "dev": "next dev",
    "build": "npm run db:migrate && npm run build:app",
    "build:app": "next build --webpack",
    "typecheck": "tsc --noEmit --incremental false",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "next start",
    "db:migrate": "node scripts/migrate.mjs",
    "db:migrate:local": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/migrate.mjs",
    "deploy:build": "npm run build",
    "security:audit": "node scripts/security-audit.mjs",
    "security:fix": "node scripts/security-audit.mjs --fix",
    "security:verify": "npm audit --omit=dev && npm run build:app",
    "verify:local": "npm run lint && npm test && npm run schema:validate && npm run build:app && npm run typecheck",
    "lint": "eslint . --max-warnings 27",
    "auth:hash": "node scripts/generate-admin-password-hash.mjs",
    "schema:validate": "node scripts/validate-schema-baseline.mjs",
    "schema:validate:isolated": "node scripts/validate-isolated-mysql.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@vercel/analytics": "1.6.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.16.0",
    "mysql2": "^3.24.4",
    "next": "16.3.6",
    "react": "^19",
    "react-dom": "^19",
    "shadcn": "^4.8.0",
    "tailwind-merge": "^3.3.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.0",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.6",
    "postcss": "^8.5",
    "tailwindcss": "^4.2.0",
    "typescript": "5.7.3",
    "vitest": "5.0.3"
  }
}
