# Copy to .env.local for local development. Never commit real values.

ADMIN_EMAIL=admin@example.com
# Generate with: npm run auth:hash -- <new-admin-password>
ADMIN_PASSWORD_HASH=scrypt:<salt>:<hex>
SESSION_SECRET=<long-random-secret>

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=global_lab
MYSQL_PASSWORD=<mysql-password>
MYSQL_DATABASE=global_lab
MYSQL_CONNECTION_LIMIT=10

R2_BUCKET=<bucket-name>
R2_ACCESS_KEY_ID=<access-key-id>
R2_SECRET_ACCESS_KEY=<secret-access-key>
# Use either R2_ENDPOINT or CLOUDFLARE_ACCOUNT_ID.
R2_ENDPOINT=
CLOUDFLARE_ACCOUNT_ID=
